package {
    // See: http://go/android-license-faq
    // A large-scale-change added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "vendor_amlogic_common_license"
    // to get the below license kinds:
    //   SPDX-license-identifier-Apache-2.0
    //   SPDX-license-identifier-FTL
    //   SPDX-license-identifier-MIT
    //   legacy_by_exception_only (by exception only)
    //   legacy_notice
    //   legacy_unencumbered
    default_applicable_licenses: ["vendor_amlogic_common_license"],
}

bootstrap_go_package {
    name: "mediahal_sdk",
    pkgPath: "android/soong/vendor/amlogic/mediahal_sdk",
    deps: [
        "blueprint",
        "blueprint-pathtools",
        "soong",
        "soong-android",
        "soong-cc",
        "soong-genrule",
    ],
    srcs: [
        "mediahal_sdk.go",
    ],
    pluginFor: ["soong_build"],
}

mediahal_sdk_go_defaults {
    name: "mediahal_sdk_go_defaults",
}

dhp_sdk_go_defaults {
    name: "dhp_sdk_go_defaults",
}

bootstrap_go_package {
    name: "mediahalvercheck",
    pkgPath: "android/soong/mediahalvercheck",
    deps: [
        "blueprint",
        "blueprint-pathtools",
        "soong",
        "soong-android",
        "soong-cc",
        "soong-genrule",
    ],
    srcs: [
        "mediahalvercheck.go",
    ],
    pluginFor: ["soong_build"],
}

mediahalvercheck_defaults {
    name: "mediahalvercheck_defaults",
}

mediahalvercheck_mediahal_passthrough_defaults {
    name: "mediahalvercheck_mediahal_passthrough_defaults",
}
cc_library_headers {
    name: "libmediahal_headers",
    vendor: true,
    export_include_dirs: ["include"],
}

cc_prebuilt_library_shared {
    name: "libmediahal_videodec",
    vendor: true,
    strip: {
    none: true,
    },

    arch: {
        arm: {
            srcs: ["lib/vendor/libmediahal_videodec.so"],
        },
        arm64: {
            srcs: ["arm64/vendor/libmediahal_videodec.so"],
        },
        x86: {
            enabled: false,
        },
        x86_64: {
            enabled: false,
        },
    },
    check_elf_files: false,
}

